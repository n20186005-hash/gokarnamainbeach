---
import LegalLayout from '../layouts/LegalLayout.astro';
export const prerender = true;
---
<LegalLayout title="ಕುಕೀ ಆಯ್ಕೆಗಳು | ಗೋಕರ್ಣ ಕರಾವಳಿ ಮಾರ್ಗದರ್ಶಿ" description="ಗೋಕರ್ಣ ಕರಾವಳಿ ಮಾರ್ಗದರ್ಶಿಯ ಅಗತ್ಯ, ವಿಶ್ಲೇಷಣಾ ಮತ್ತು ಆದ್ಯತಾ ಕುಕೀ/ಸ್ಥಳೀಯ ಸಂಗ್ರಹ ಆಯ್ಕೆಗಳನ್ನು ನಿರ್ವಹಿಸಿ.">
  <p class="eyebrow">ಕುಕೀ ಆಯ್ಕೆಗಳು</p>
  <h1 class="mt-3 text-4xl font-black tracking-tight text-ocean-900">ನೀವು ಯಾವ ಐಚ್ಛಿಕ ದತ್ತಾಂಶ ಬಳಕೆಗೆ ಒಪ್ಪುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೀವೇ ನಿಯಂತ್ರಿಸಿ</h1>
  <p class="mt-4 text-sm font-bold text-slate-500">ಕೊನೆಯ ನವೀಕರಣ: 22 ಅಕ್ಟೋಬರ್ 2026</p>

  <p class="mt-7">ಈ ತಾಣವು ಕಾರ್ಯನಿರ್ವಹಣೆಗೆ ಅಗತ್ಯವಿರುವ ಕನಿಷ್ಠ ಸ್ಥಳೀಯ ಸಂಗ್ರಹವನ್ನು ಬಳಸುತ್ತದೆ. ವಿಶ್ಲೇಷಣಾ ಸೇವೆ ನಿಮ್ಮ ಸ್ಪಷ್ಟ ಒಪ್ಪಿಗೆಯ ನಂತರ ಮಾತ್ರ ಸಕ್ರಿಯವಾಗುತ್ತದೆ. ಕೆಳಗಿನ ಆಯ್ಕೆಗಳನ್ನು ಉಳಿಸಿದಾಗ ಅವು ನಿಮ್ಮ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಮಾತ್ರ ಸಂಗ್ರಹವಾಗುತ್ತವೆ.</p>

  <div class="mt-8 space-y-4" data-cookie-panel>
    <div class="rounded-2xl border border-ocean-900/10 bg-sand-50 p-5">
      <div class="flex items-start justify-between gap-5">
        <div><h2 class="!m-0 !text-lg">ಅಗತ್ಯ ಸಂಗ್ರಹ</h2><p class="mt-2 text-sm">ತಾಣದ ಮೂಲ ಕಾರ್ಯ ಮತ್ತು ನಿಮ್ಮ ಕುಕೀ ಆಯ್ಕೆ ನೆನಪಿಡಲು ಅಗತ್ಯ. ಇದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ.</p></div>
        <label class="inline-flex items-center gap-2 text-sm font-bold"><input type="checkbox" checked disabled class="h-5 w-5" /> ಸದಾ ಸಕ್ರಿಯ</label>
      </div>
    </div>

    <div class="rounded-2xl border border-ocean-900/10 bg-white p-5">
      <div class="flex items-start justify-between gap-5">
        <div><h2 class="!m-0 !text-lg">ವಿಶ್ಲೇಷಣಾ ಕುಕೀಗಳು</h2><p class="mt-2 text-sm">Google Analytics ಬಳಕೆ ಮತ್ತು ಸಾಧನದ ತಾಂತ್ರಿಕ ಮಾಹಿತಿಯನ್ನು ಸಂಸ್ಕರಿಸಬಹುದು; ಸಂಪೂರ್ಣ ಅನಾಮಧೇಯತೆ ಎಂಬ ಭರವಸೆ ಇಲ್ಲ.</p><h3 class="!mt-4">ಗೂಗಲ್ ಅನಾಲಿಟಿಕ್ಸ್ 4</h3><p class="mt-1 text-sm">ನಿಮ್ಮ ಅನುಮತಿ ಸಂಗ್ರಹದಿಂದ ಓದಿ ದೃಢಪಡಿಸಿದಾಗ ಮಾತ್ರ ವಿಶ್ಲೇಷಣಾ ಸ್ಕ್ರಿಪ್ಟ್ ಲೋಡ್ ಆಗುತ್ತದೆ.</p></div>
        <label class="inline-flex shrink-0 items-center gap-2 text-sm font-bold"><input id="analytics" type="checkbox" class="h-5 w-5 accent-ocean-700" /> ಸಕ್ರಿಯಗೊಳಿಸಿ</label>
      </div>
    </div>

    <div class="rounded-2xl border border-ocean-900/10 bg-white p-5">
      <div class="flex items-start justify-between gap-5">
        <div><h2 class="!m-0 !text-lg">ಆದ್ಯತಾ ಸಂಗ್ರಹ</h2><p class="mt-2 text-sm">ಪ್ರಸ್ತುತ ಪ್ರತ್ಯೇಕ ಆದ್ಯತಾ ಸಂಗ್ರಹ ವೈಶಿಷ್ಟ್ಯವಿಲ್ಲ. ಈ ಆಯ್ಕೆ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ.</p></div>
        <label class="inline-flex shrink-0 items-center gap-2 text-sm font-bold"><input id="preferences" type="checkbox" disabled class="h-5 w-5 accent-ocean-700" /> ನಿಷ್ಕ್ರಿಯ</label>
      </div>
    </div>

    <div class="rounded-2xl border border-ocean-900/10 bg-white p-5 opacity-75">
      <div class="flex items-start justify-between gap-5">
        <div><h2 class="!m-0 !text-lg">ಮಾರ್ಕೆಟಿಂಗ್ ಕುಕೀಗಳು</h2><p class="mt-2 text-sm">ವೈಯಕ್ತಿಕ ಜಾಹೀರಾತು ಅಥವಾ ಜಾಹೀರಾತು ಅಭಿಯಾನ ಮಾಪನಕ್ಕೆ ಬಳಸುವ ವರ್ಗ. ಈ ಲಾಭರಹಿತ ತಾಣದಲ್ಲಿ ಪ್ರಸ್ತುತ ಇಂತಹ ಕುಕೀ ಬಳಸುವುದಿಲ್ಲ.</p></div>
        <label class="inline-flex shrink-0 items-center gap-2 text-sm font-bold"><input type="checkbox" disabled class="h-5 w-5" /> ನಿಷ್ಕ್ರಿಯ</label>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 pt-3">
      <button type="button" data-save class="rounded-full bg-ocean-900 px-6 py-3 text-sm font-extrabold text-white hover:bg-ocean-700">ಆಯ್ಕೆಗಳನ್ನು ಉಳಿಸಿ</button>
      <button id="reject-all" type="button" data-reject class="rounded-full border border-ocean-900/20 bg-white px-6 py-3 text-sm font-extrabold text-ocean-900 hover:bg-ocean-50">ಐಚ್ಛಿಕ ಎಲ್ಲವನ್ನೂ ನಿರಾಕರಿಸಿ</button>
    </div>
    <p id="cookie-status" data-status class="min-h-6 text-sm font-bold text-ocean-700" aria-live="polite"></p>
  </div>

  <h2>ಒಪ್ಪಿಗೆ ನಿರ್ವಹಣೆ</h2>
  <p>ನೀವು ಈ ಪುಟಕ್ಕೆ ಮರಳಿ ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ಆಯ್ಕೆ ಬದಲಾಯಿಸಬಹುದು. ನಿರಾಕರಣೆ ಈ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತಕ್ಷಣ Google Analytics ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ. ಈಗಾಗಲೇ ಕಳುಹಿಸಿದ ವಿನಂತಿಗಳನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಲು ಸಾಧ್ಯವಿಲ್ಲ. ಸಂಗ್ರಹ ವಿಫಲವಾದರೆ ಸಂದೇಶದಲ್ಲಿ ಆಯ್ಕೆ ಉಳಿದಿದೆಯೇ ಎಂಬುದನ್ನು ತಿಳಿಸುತ್ತೇವೆ. ಹಿಂದಿನ ಮೂರನೇ ವ್ಯಕ್ತಿಯ ಕುಕೀಗಳನ್ನು ಅಳಿಸಲು ಬ್ರೌಸರ್‌ನ ತಾಣದ ದತ್ತಾಂಶ ನಿಯಂತ್ರಣ ಬಳಸಿ.</p>

  <h2>ನಕ್ಷೆ ಎಂಬೆಡ್ ಕುರಿತು</h2>
  <p>ಮುಖ್ಯ ಪುಟದ Google Maps ಎಂಬೆಡ್ ತನ್ನದೇ ತಾಂತ್ರಿಕ ವಿನಂತಿಗಳನ್ನು ಮಾಡುತ್ತದೆ; ವಿಶ್ಲೇಷಣಾ ಆಯ್ಕೆ ಅದನ್ನು ತಡೆಯುವುದಿಲ್ಲ. Cloudflare ವಿತರಣೆ, ಭದ್ರತೆ ಮತ್ತು ಪ್ರತ್ಯೇಕ Web Analytics / Browser Insights ಕಾರ್ಯಕ್ಷಮತಾ ಮಾಪನಕ್ಕೂ ಈ GA ಆಯ್ಕೆ ಅನ್ವಯಿಸುವುದಿಲ್ಲ. ವಿವರಗಳಿಗೆ <a href="/privacy/">ಗೌಪ್ಯತಾ ನೀತಿ</a> ನೋಡಿ.</p>

</LegalLayout>
