---
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const home = path === '/' || path === '/en/';
const isEn = path.startsWith('/en');
// The language switcher is only shown on the two home pages, since only the
// home exists in both languages (subpages are English-only).
const showSwitch = (isEn && path === '/en/') || (!isEn && path === '/');
const switchPath = isEn ? '/' : '/en/';
const switchLabel = isEn ? 'ಕನ್ನಡ' : 'English';
---
<header class="sticky top-0 z-50 border-b border-ocean-900/10 bg-sand-50/95 backdrop-blur-xl">
  <div class="shell flex min-h-18 items-center justify-between gap-5 py-3">
    <Logo compact />
    <nav aria-label={isEn ? 'Main navigation' : 'ಮುಖ್ಯ ಸಂಚರಣೆ'} class="hidden items-center gap-6 text-sm font-bold text-ocean-900 md:flex">
      {home ? (
        isEn ? (
          <>
            <a href="#guide" class="hover:text-temple-500">Guide</a>
            <a href="#weather" class="hover:text-temple-500">Weather</a>
            <a href="#tides" class="hover:text-temple-500">Tides</a>
            <a href="#nearby" class="hover:text-temple-500">Nearby</a>
            <a href="#getting-there" class="hover:text-temple-500">Getting there</a>
            <a href="#faq" class="hover:text-temple-500">FAQ</a>
          </>
        ) : (
          <>
            <a href="#ಪರಿಚಯ" class="hover:text-temple-500">ಪರಿಚಯ</a>
            <a href="#ಯೋಜನೆ" class="hover:text-temple-500">ಭೇಟಿ ಯೋಜನೆ</a>
            <a href="#ಸೌಲಭ್ಯ" class="hover:text-temple-500">ಸೌಲಭ್ಯಗಳು</a>
            <a href="#ಸಾರಿಗೆ" class="hover:text-temple-500">ಸಾರಿಗೆ</a>
            <a href="#ಪ್ರಶ್ನೆಗಳು" class="hover:text-temple-500">ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆಗಳು</a>
          </>
        )
      ) : (
        <a href={isEn ? '/en/' : '/'} class="rounded-full bg-ocean-900 px-5 py-2.5 text-white hover:bg-ocean-700">
          {isEn ? 'Back to guide' : 'ಕಡಲತೀರ ಮಾರ್ಗದರ್ಶಿಗೆ ಮರಳಿ'}
        </a>
      )}
    </nav>
    <div class="flex items-center gap-3">
      {showSwitch && (
        <a href={switchPath} class="rounded-full border border-ocean-900/15 px-4 py-2.5 text-sm font-bold text-ocean-900 hover:bg-ocean-900 hover:text-white">
          {switchLabel}
        </a>
      )}
      {home && <a href={isEn ? '#map' : '#ನಕ್ಷೆ'} class="rounded-full bg-ocean-900 px-4 py-2.5 text-sm font-bold text-white md:hidden">
        {isEn ? 'Map' : 'ನಕ್ಷೆ'}
      </a>}
    </div>
  </div>
</header>
