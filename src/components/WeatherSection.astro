---
import { getWeather } from '../lib/weather';
import type { Lang } from '../lib/weather';
import { weatherView } from '../lib/widget-view';
interface Props { lang?: Lang; }
const { lang = 'kn' } = Astro.props;
const data = await getWeather(lang);
const UI = lang === 'en' ? {
  eyebrow: 'Weather',
  title: 'Current weather and the next 7 days',
  lead: 'Model estimates near Main Beach, not an on-site weather station. While this page is open it tries to refresh every 10 minutes and when you return to the tab; server snapshots may be cached for 10 minutes.',
  adviceNote: 'Tips use model data and are not official warnings or a swimming-safety assessment. Check local conditions and official alerts.',
} : {
  eyebrow: 'ಹವಾಮಾನ',
  title: 'ಪ್ರಸ್ತುತ ಹವಾಮಾನ ಮತ್ತು ಮುಂದಿನ ೭ ದಿನಗಳು',
  lead: 'ಮುಖ್ಯ ಕಡಲತೀರದ ಸಮೀಪದ ಮಾದರಿ ಅಂದಾಜು; ಸ್ಥಳದಲ್ಲಿನ ಹವಾಮಾನ ಕೇಂದ್ರದ ಮಾಪನವಲ್ಲ. ಪುಟ ತೆರೆದಿರುವಾಗ ಪ್ರತಿ 10 ನಿಮಿಷಕ್ಕೆ ಮತ್ತು ಟ್ಯಾಬ್‌ಗೆ ಮರಳಿದಾಗ ನವೀಕರಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ; ಸರ್ವರ್ ದತ್ತಾಂಶವನ್ನು 10 ನಿಮಿಷ ಉಳಿಸಬಹುದು.',
  adviceNote: 'ಸಲಹೆಗಳು ಮಾದರಿ ದತ್ತಾಂಶದಿಂದ ಉತ್ಪನ್ನವಾಗಿವೆ; ಅಧಿಕೃತ ಎಚ್ಚರಿಕೆ ಅಥವಾ ಈಜಿನ ಸುರಕ್ಷತಾ ಮೌಲ್ಯಮಾಪನವಲ್ಲ. ಸ್ಥಳೀಯ ಪರಿಸ್ಥಿತಿ ಮತ್ತು ಅಧಿಕೃತ ಸೂಚನೆ ಪರಿಶೀಲಿಸಿ.',
};
---
<section id={lang === 'en' ? 'weather' : 'ಹವಾಮಾನ'} class="shell py-18 md:py-24" data-widget="weather" data-lang={lang} data-loaded={Boolean(data)}>
  <div class="max-w-3xl"><p class="eyebrow">{UI.eyebrow}</p><h2 class="section-title mt-3">{UI.title}</h2><p class="lead mt-5">{UI.lead}</p></div>
  <p data-widget-status class="mt-4 text-sm font-bold text-slate-600" role="status" aria-live="polite"></p>
  <div data-widget-body set:html={weatherView(data, lang)}></div>
  <p class="mt-6 max-w-3xl text-xs leading-6 text-slate-600">{UI.adviceNote} <a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
</section>
<script>import '../lib/widget-client';</script>
