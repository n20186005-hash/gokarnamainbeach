---
import { getTides } from '../lib/tides';
import type { Lang } from '../lib/weather';
import { tidesView } from '../lib/widget-view';
interface Props { lang?: Lang; }
const { lang = 'kn' } = Astro.props;
const data = await getTides();
const UI = lang === 'en' ? {
  eyebrow: 'Tides',
  title: 'Sea-level model and estimated tide times',
  lead: 'Hourly offshore model estimates can help explain sea-level changes. They do not measure beach water depth, currents or swimming safety.',
  footnote: 'Turning points are estimated from hourly samples, not an official tide table. Coastal model accuracy is limited; do not use this for navigation or water-entry decisions. Refresh is attempted every 10 minutes while open and on returning to the tab; server cache is up to 10 minutes. Times use India Standard Time (IST).',
} : {
  eyebrow: 'ಜ್ವಾರಭಾಟ',
  title: 'ಸಮುದ್ರ ಮಟ್ಟದ ಮಾದರಿ ಮತ್ತು ಅಂದಾಜು ಜ್ವಾರಭಾಟ ಸಮಯ',
  lead: 'ಗಂಟೆಯ ಸಮುದ್ರ ಮಾದರಿ ಅಂದಾಜುಗಳು ಮಟ್ಟದ ಬದಲಾವಣೆ ತಿಳಿಯಲು ಸಹಾಯಕ. ಇವು ಕಡಲತೀರದ ನೀರಿನ ಆಳ, ಪ್ರವಾಹ ಅಥವಾ ಈಜಿನ ಸುರಕ್ಷತೆಯನ್ನು ಅಳೆಯುವುದಿಲ್ಲ.',
  footnote: 'ತಿರುವುಗಳನ್ನು ಗಂಟೆಯ ಮಾದರಿಗಳಿಂದ ಅಂದಾಜಿಸಲಾಗಿದೆ; ಅಧಿಕೃತ ಜ್ವಾರಭಾಟ ಪಟ್ಟಿಯಲ್ಲ. ಕರಾವಳಿಯಲ್ಲಿ ಮಾದರಿಯ ನಿಖರತೆ ಸೀಮಿತ. ನೌಕಾಯಾನ ಅಥವಾ ನೀರಿಗೆ ಇಳಿಯುವ ನಿರ್ಧಾರಕ್ಕೆ ಬಳಸಬೇಡಿ. ತೆರೆದಿರುವಾಗ ಪ್ರತಿ 10 ನಿಮಿಷಕ್ಕೆ ಹಾಗೂ ಟ್ಯಾಬ್‌ಗೆ ಮರಳಿದಾಗ ನವೀಕರಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ; ಸರ್ವರ್ ಸಂಗ್ರಹ 10 ನಿಮಿಷವರೆಗೆ. ಸಮಯ ಭಾರತೀಯ ಪ್ರಮಾಣಿತ ಸಮಯ (IST).',
};
---
<section id={lang === 'en' ? 'tides' : 'ಜ್ವಾರಭಾಟ'} class="shell py-18 md:py-24" data-widget="tides" data-lang={lang} data-loaded={Boolean(data)}>
  <div class="max-w-3xl"><p class="eyebrow">{UI.eyebrow}</p><h2 class="section-title mt-3">{UI.title}</h2><p class="lead mt-5">{UI.lead}</p></div>
  <p data-widget-status class="mt-4 text-sm font-bold text-slate-600" role="status" aria-live="polite"></p>
  <div data-widget-body set:html={tidesView(data, lang)}></div>
  <p class="mt-6 max-w-3xl text-xs leading-6 text-slate-600">{UI.footnote} <a href="https://open-meteo.com/">Open-Meteo</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></p>
</section>
<script>import '../lib/widget-client';</script>
