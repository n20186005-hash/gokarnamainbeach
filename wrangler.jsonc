{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gokarna-main-beach-guide",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  }
}
